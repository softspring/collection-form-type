{
    "name": "softspring/collection-form-type",
    "description": "JavaScript helpers for dynamic collection form interactions in Symfony applications",
    "type": "library",
    "license": "AGPL-3.0-or-later",
    "minimum-stability": "dev",
    "prefer-stable": true,
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "ergebnis/composer-normalize": true
        }
    },
    "require-dev": {
        "ergebnis/composer-normalize": "^2.50",
        "symfony/console": "^6.4 || ^7.4 || ^8.0",
        "symfony/yaml": "^6.4 || ^7.4 || ^8.0"
    },
    "scripts": {
        "fix": [
            "composer normalize"
        ],
        "build-assets": [
            "npm --prefix assets ci",
            "npm --prefix assets run build"
        ],
        "run-tests": [
            "composer validate --strict --no-check-lock --ansi",
            "vendor/bin/yaml-lint .github/ -vvv --parse-tags"
        ],
        "test": [
            "composer update --no-scripts --ansi",
            "@run-tests"
        ],
        "test-bc": [
            "composer update --no-scripts --ansi --prefer-lowest --prefer-stable",
            "@run-tests"
        ]
    },
    "extra": {
        "branch-alias": {
            "dev-6.0": "6.0.x-dev"
        }
    }
}
